{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_TIMEOUT_MS",
    "API_URL",
    "CI",
    "CORS_ORIGINS",
    "DATABASE_URL",
    "JWT_REFRESH_SECRET",
    "JWT_SECRET",
    "NEXT_PUBLIC_API_TIMEOUT_MS",
    "NEXT_PUBLIC_API_URL",
    "NODE_ENV",
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
    "PORT",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_PUBLIC_URL",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "THROTTLE_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:unit": {
      "dependsOn": ["^test:unit"]
    },
    "test:e2e": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
