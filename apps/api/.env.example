# Database (local Docker/Postgres default)
# For production, keep the same DATABASE_URL variable name but use your managed Postgres URL.
DATABASE_URL="postgresql://armut:armut123@localhost:5432/armut_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# CORS (comma-separated for multiple origins, '*' wildcards supported)
CORS_ORIGINS="http://localhost:3000,http://localhost:8081,https://your-web-domain.vercel.app,https://your-preview-domain-*.vercel.app"

# Redis (optional - falls back to in-memory if not set)
REDIS_URL="redis://localhost:6379"

# Rate Limiting
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_STRICT=10
RATE_LIMIT_RELAXED=200

# Stripe (for payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email: no provider or sender identity selected yet
EMAIL_FROM=""

# File Storage (S3/R2)
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
# Separate non-public bucket; leave unset until docs/UPLOAD_SECURITY.md checks pass.
S3_PRIVATE_BUCKET=""

# Meilisearch (optional - falls back to database search)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# Google Maps
GOOGLE_MAPS_API_KEY=""

# Optional release identity fallback; Railway supplies RAILWAY_GIT_COMMIT_SHA.
# APP_COMMIT_SHA must be the full deployed commit, never a branch name.

# Password recovery: disabled until explicitly configured.
# local captures private messages for development/testing; never use in beta/production.
EMAIL_TRANSPORT="disabled" # disabled | local | smtp
EMAIL_LOCAL_DIR=".local-mail"
FRONTEND_URL="http://localhost:3000" # HTTPS origin required outside development/test
# Provider is not selected. For real delivery, configure its SMTP credentials
# and replace EMAIL_FROM above with your verified sender on a domain you own.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false" # false requires STARTTLS; true uses implicit TLS (usually port 465)
SMTP_USER=""
SMTP_PASSWORD=""
